# Impeccable AI Colossus - Enterprise Configuration
# Copy this file to .env and provide your API keys.

# 1. Google Gemini API (Required for AI Audits, Marketing & Churn Prediction)
# Start Free: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Firebase Configuration (Required for Multitenant Auth & Database)
# Start Free: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# 3. Google Maps API (Required for Client Locations & Route Optimization)
# Start Free Tier ($200 monthly credit): https://console.cloud.google.com/google/maps-apis/
VITE_GOOGLE_MAPS_API_KEY=

# 4. Stripe API (Required for Multitenant Billing & Subscriptions)
# Start with Test Mode: https://stripe.com/
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 5. OpenClaw Autonomous Agent Integration (n8n + VPS / OpenBridge)
# URL: La dirección de tu VPS (ej: https://n8n.tudominio.com/webhook)
# API_KEY: El token de seguridad que configuraste en OpenClaw
VITE_OPENCLAW_URL=
VITE_OPENCLAW_API_KEY=

# 6. Email Automation (Resend)
RESEND_API_KEY=
# Start Free: https://resend.com/
RESEND_API_KEY=
